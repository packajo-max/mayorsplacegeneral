# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK CONFIGURATION
# PAYSTACK_SECRET_KEY: Secret API key from Paystack Dashboard (starts with sk_test_ or sk_live_)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VITE_PAYSTACK_PUBLIC_KEY: Public key for client-side inline checkout if needed (pk_test_ or pk_live_)
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# PAYSTACK_BUSINESS_SUBACCOUNT: Subaccount code for the business (e.g. ACCT_xxxxxxx)
PAYSTACK_BUSINESS_SUBACCOUNT="ACCT_xxxxxxxxxxxxxxx"

# NOTIFICATION PROVIDERS (Configurable for Nigeria)
# TERMII_API_KEY: For Nigerian SMS delivery (Termii provider)
TERMII_API_KEY="TL_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TERMII_SENDER_ID="AGROSTREAM"

# RESEND_API_KEY: For transactional email delivery (or SENDGRID_API_KEY)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="notifications@example.com"

